# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Build and packaging outputs
build/
dist/
*.egg-info/
.nuitka-cache/
*.spec

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# IDE/editor files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Runtime outputs and local artifacts
.cache/
output/
logs/
tmp/
temp/
*.log

# Environment/config secrets
.env
.env.*
!.env.example

# AI model and external binaries (keep placeholders via .gitkeep if needed)
models/**/*
!models/**/.gitkeep
third_party/ffmpeg/**/*
!third_party/ffmpeg/**/.gitkeep
